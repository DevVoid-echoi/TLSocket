# TLSocket runtime configuration (all optional)
# Copy to .env and adjust, or export these in your shell.

# Network
TLSOCKET_HOST=0.0.0.0
TLSOCKET_PORT=9999

# Directories (resolved relative to the working directory by default)
TLSOCKET_DATA_DIR=data
TLSOCKET_LOG_DIR=logs
TLSOCKET_CERT_DIR=certs

# Explicit TLS file paths (override TLSOCKET_CERT_DIR)
#TLSOCKET_CERT_FILE=certs/server.crt
#TLSOCKET_KEY_FILE=certs/server.key
